# CARTO basemap API key — free, no approval queue: https://carto.com/basemaps/apikey/
# Removes the "API KEY REQUIRED" watermark on the dark map tiles used by
# WorldMap.tsx (v1) and OnboardingMapV2.tsx (v2, via lib/mapKit.ts).
# Copy this file to `.env` and paste your real key below.
VITE_CARTO_API_KEY=
